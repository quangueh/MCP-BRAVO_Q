{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bravo Layout XML Schema",
  "description": "JSON Schema definition for Bravo ERP Layout XML structure",
  "type": "object",
  "properties": {
    "toolStrip1": {
      "type": "object",
      "description": "Top toolbar with action buttons",
      "properties": {
        "Items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Name": { "type": "string" },
              "Text": { "type": "string" },
              "ImageKey": { "type": "string" },
              "BravoCommandKey": { "type": "string", "enum": ["New", "Edit", "Delete", "Refresh", "Search", "Save", "Cancel", "Print", "Export", "Approve", "Reject"] }
            }
          }
        }
      }
    },
    "menuStrip1": {
      "type": "object",
      "description": "Main menu bar",
      "properties": {
        "Items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Name": { "type": "string" },
              "Text": { "type": "object", "description": "Multi-language text nodes" }
            }
          }
        }
      }
    },
    "showCommandButtons": {
      "type": "boolean",
      "description": "Whether to show command buttons on the toolbar"
    },
    "panelExplorer": {
      "type": "object",
      "description": "Explorer panel containing grid/list view",
      "properties": {
        "BravoTabControl": {
          "type": "object",
          "properties": {
            "Pages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "Name": { "type": "string" },
                  "Text": { "type": "object" },
                  "BravoGridContainer": {
                    "type": "object",
                    "properties": {
                      "DataMember": { "type": "string" },
                      "Cols": {
                        "type": "array",
                        "items": { "$ref": "#/definitions/columnDef" }
                      },
                      "zTreeColName": { "type": "string" },
                      "zMakingTreeNodeKeyColName": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "panelEditor": {
      "type": "object",
      "description": "Editor panel for data entry",
      "properties": {
        "panelHeader": {
          "type": "object",
          "properties": {
            "Controls": {
              "type": "array",
              "items": { "$ref": "#/definitions/controlDef" }
            }
          }
        },
        "panelDetail": {
          "type": "object",
          "properties": {
            "BravoGridContainer": {
              "type": "object",
              "properties": {
                "DataMember": { "type": "string" },
                "Cols": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/columnDef" }
                }
              }
            }
          }
        }
      }
    },
    "panelReporter": {
      "type": "object",
      "description": "Report panel with parameters and output",
      "properties": {
        "panelParameters": {
          "type": "object",
          "properties": {
            "Controls": {
              "type": "array",
              "items": { "$ref": "#/definitions/controlDef" }
            }
          }
        },
        "panelReporter": {
          "type": "object",
          "properties": {
            "Report_0": {
              "type": "object",
              "properties": {
                "Content": {
                  "type": "object",
                  "properties": {
                    "DataMember": { "type": "string" },
                    "Cols": {
                      "type": "array",
                      "items": { "$ref": "#/definitions/columnDef" }
                    },
                    "SumColumns": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "Groups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "GroupCol": { "type": "string" },
                          "ShowHeader": { "type": "boolean" },
                          "ShowFooter": { "type": "boolean" }
                        }
                      }
                    },
                    "zTreeColName": { "type": "string" },
                    "zMakingTreeNodeKeyColName": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "contextMenu1": {
      "type": "object",
      "description": "Right-click context menu",
      "properties": {
        "Items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Name": { "type": "string" },
              "Text": { "type": "string" },
              "BravoCommandKey": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "columnDef": {
      "type": "object",
      "description": "Column definition for grid display",
      "properties": {
        "Name": { "type": "string" },
        "Header": { "type": "object", "description": "Multi-language header text" },
        "DataMember": { "type": "string" },
        "Width": { "type": "integer" },
        "TextAlign": { "type": "string", "enum": ["LeftTop", "CenterTop", "RightTop", "LeftMiddle", "CenterMiddle", "RightMiddle"] },
        "Format": { "type": "string" },
        "Visible": { "type": "boolean" },
        "ReadOnly": { "type": "boolean" },
        "WordWrap": { "type": "boolean" },
        "Style": { "$ref": "#/definitions/styleDef" },
        "HeaderStyle": { "$ref": "#/definitions/styleDef" }
      },
      "required": ["Name", "DataMember"]
    },
    "controlDef": {
      "type": "object",
      "description": "UI control definition",
      "properties": {
        "Name": { "type": "string" },
        "Assembly": { "type": "string" },
        "ClassName": { "type": "string" },
        "DataMember": { "type": "string" },
        "Width": { "type": "integer" },
        "Height": { "type": "integer" },
        "Text": { "type": "object" },
        "LookupSource": { "type": "string" },
        "Style": { "$ref": "#/definitions/styleDef" }
      },
      "required": ["Name", "ClassName"]
    },
    "styleDef": {
      "type": "object",
      "description": "Visual style properties",
      "properties": {
        "BackColor": { "type": "string" },
        "ForeColor": { "type": "string" },
        "Font": { "type": "string" },
        "TextAlign": { "type": "string" },
        "Format": { "type": "string" },
        "WordWrap": { "type": "boolean" }
      }
    }
  }
}
