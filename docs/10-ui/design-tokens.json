  "typography": {
    "fontFamily": "Segoe UI, -apple-system, BlinkMacSystemFont, sans-serif",
    "fontFamilyMono": "Cascadia Code, Consolas, monospace",
    "sizes": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "20px",
      "xl": "24px",
      "2xl": "32px"
    },
    "weights": {
      "regular": 400,
      "semibold": 600,
      "bold": 700
    },
    "lineHeights": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.75
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
