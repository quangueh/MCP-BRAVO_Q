{
  "colors": {
    "primary": "#0078D4",
    "primaryDark": "#005A9E",
    "primaryLight": "#4BA1E8",
    "background": {
      "dark": "#1E1E1E",
      "light": "#FFFFFF"
    },
    "surface": {
      "dark": "#2D2D2D",
      "light": "#F5F5F5"
    },
    "surfaceHover": {
      "dark": "#383838",
      "light": "#E8E8E8"
    },
    "text": {
      "primary": {
        "dark": "#FFFFFF",
        "light": "#1A1A1A"
      },
      "secondary": {
        "dark": "#B0B0B0",
        "light": "#666666"
      },
      "disabled": {
        "dark": "#666666",
        "light": "#AAAAAA"
      }
    },
    "border": {
      "dark": "#404040",
      "light": "#E0E0E0"
    },
    "success": "#107C10",
    "warning": "#FFB900",
    "error": "#D13438",
    "info": "#0078D4"
